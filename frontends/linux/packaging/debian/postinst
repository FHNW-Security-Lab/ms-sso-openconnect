#!/bin/bash
set -euo pipefail

INSTALL_DIR="/opt/ms-sso-openconnect-ui"
export PLAYWRIGHT_BROWSERS_PATH="$INSTALL_DIR/browsers"

case "${1:-}" in
    configure)
        # System Qt/keyring packages are maintained by APT. Only Playwright's
        # coherent Python/Node runtime is installed into this private venv.
        # Recreate a broken venv after a distro Python upgrade.
        if ! "$INSTALL_DIR/venv/bin/python" -c 'import sys, pip; assert sys.version_info >= (3, 10)' 2>/dev/null; then
            rm -rf "$INSTALL_DIR/venv"
            python3 -m venv --system-site-packages "$INSTALL_DIR/venv"
        fi
        # Enable distro packages in environments created by releases <= 2.0.0.
        sed -i 's/include-system-site-packages = false/include-system-site-packages = true/' "$INSTALL_DIR/venv/pyvenv.cfg"
        # Old releases installed vpn_ui in site-packages. The dpkg-owned source
        # is now used directly, so remove stale copies before checking imports.
        "$INSTALL_DIR/venv/bin/python" -m pip uninstall -y ms-sso-openconnect-ui >/dev/null 2>&1 || true
        if ! "$INSTALL_DIR/venv/bin/python" -c 'from importlib.metadata import version; assert (1, 55) <= tuple(map(int, version("playwright").split(".")[:2])) < (2, 0); from playwright.sync_api import sync_playwright; p = sync_playwright().start(); p.stop()' 2>/dev/null; then
            "$INSTALL_DIR/venv/bin/python" -m pip install --upgrade 'playwright>=1.55,<2'
        fi
        check_chromium() {
            "$INSTALL_DIR/venv/bin/python" -c 'from playwright.sync_api import sync_playwright; p = sync_playwright().start(); b = p.chromium.launch(headless=True, args=["--no-sandbox"]); b.close(); p.stop()'
        }
        if ! check_chromium >/dev/null 2>&1; then
            mkdir -p "$PLAYWRIGHT_BROWSERS_PATH"
            "$INSTALL_DIR/venv/bin/python" -m playwright install chromium
            check_chromium || {
                echo "ERROR: Chromium cannot start; verify the package runtime dependencies." >&2
                exit 1
            }
        fi
        # Check the actual launcher imports without opening a GUI or a VPN.
        PYTHONPATH="$INSTALL_DIR/src:$INSTALL_DIR" "$INSTALL_DIR/venv/bin/python" -c 'import PyQt6.QtWidgets, keyring, core, vpn_ui'
        ;;
esac

#DEBHELPER#
exit 0
